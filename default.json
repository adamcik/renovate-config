{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:monthly"
  ],
  "timezone": "Europe/Oslo",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "gomod": {
    "additionalBranchPrefix": "{{{packageFile}}}-",
    "separateMinorPatch": false
  },
  "npm": {
    "additionalBranchPrefix": "{{{packageFile}}}-",
    "separateMinorPatch": false
  },
  "pep621": {
    "additionalBranchPrefix": "{{{packageFile}}}-",
    "separateMinorPatch": false
  },
  "cargo": {
    "additionalBranchPrefix": "{{{packageFile}}}-",
    "separateMinorPatch": false
  },
  "packageRules": [
    {
      "description": "Git refs do not provide release timestamps",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Group patch updates by manager",
      "matchUpdateTypes": ["patch"],
      "groupName": "{{manager}} patch updates"
    },
    {
      "description": "Group digest updates by manager",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupName": "{{manager}} digest updates"
    },
    {
      "description": "Group version pins by manager",
      "matchUpdateTypes": ["pin"],
      "groupName": "{{manager}} version pins"
    },
    {
      "description": "Group minor updates by manager",
      "matchUpdateTypes": ["minor"],
      "groupName": "{{manager}} minor updates"
    },
    {
      "description": "Group routine minor and patch updates by target manager",
      "matchManagers": ["gomod", "npm", "pep621", "cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{manager}} dependencies",
      "groupSlug": "{{manager}}-dependencies",
      "group": {
        "branchTopic": "{{{groupSlug}}}"
      }
    },
    {
      "description": "Configure target-manager security commits",
      "matchManagers": ["gomod", "npm", "pep621", "cargo"],
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "commitMessageTopic": "{{manager}} dependencies",
      "commitMessageExtra": ""
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 1-7 * 6"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": false,
    "minimumGroupSize": 1,
    "branchTopic": "{{#if (includes (toArray \"gomod\" \"npm\" \"pep621\" \"cargo\") manager)}}{{{manager}}}-security{{else}}{{{datasource}}}-{{{depNameSanitized}}}-vulnerability{{/if}}"
  }
}
